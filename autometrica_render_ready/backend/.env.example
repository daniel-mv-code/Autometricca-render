# Entorno: development local / production en Render
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/autometrica_db
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin inicial (opcional; en Render definir las tres variables)
BOOTSTRAP_ADMIN_NAME=Administrador AutoMétrica
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=UnaClaveLarga!Cambiar

# Correo: Render Free bloquea SMTP saliente en 25, 465 y 587.
# Preferir Resend mediante HTTPS.
RESEND_API_KEY=
RESEND_FROM=AutoMétrica <onboarding@resend.dev>

# SMS opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
